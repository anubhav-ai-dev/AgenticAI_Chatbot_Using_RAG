    {
      "id": "file:backend/agent.py",
      "type": "file",
      "name": "agent.py",
      "filePath": "backend/agent.py",
      "summary": "Implements the LangGraph chat agent that routes each query to RAG or a direct LLM/search path, keeps in-memory session history, and indexes PDF text in per-user FAISS stores.",
      "tags": ["langgraph", "rag", "agent", "conversation-memory", "pdf-processing"],
      "complexity": "complex",
      "languageNotes": "LangGraph StateGraph with a conditional router: document-similar queries pass through a RAG prompt node before the LLM, and non-RAG queries may use a Tavily ReAct agent."
    },
    {
      "id": "class:backend/agent.py:AgentState",
      "type": "class",
      "name": "AgentState",
      "filePath": "backend/agent.py",
      "lineRange": [51, 57],
      "summary": "LangGraph state schema carrying the message list, user and session ids, the RAG decision, similarity threshold, and retrieved documents.",
      "tags": ["state", "langgraph", "type-definition"],
      "complexity": "simple",
      "languageNotes": "TypedDict whose messages channel uses LangGraph's add_messages reducer."
    },
    {
      "id": "class:backend/agent.py:MemoryManager",
      "type": "class",
      "name": "MemoryManager",
      "filePath": "backend/agent.py",
      "lineRange": [62, 77],
      "summary": "In-memory store of per-session chat turns that timestamps each appended message and can return or clear a session's history.",
      "tags": ["memory", "session", "conversation-history"],
      "complexity": "simple"
    },
    {
