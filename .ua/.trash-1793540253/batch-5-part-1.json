      "id": "file:backend/services/retrieval_service.py",
      "type": "file",
      "name": "retrieval_service.py",
      "filePath": "backend/services/retrieval_service.py",
      "summary": "Fuses FAISS cosine hits with FTS5 BM25 through reciprocal rank fusion, reranks the candidates, and gates them by relevance, falling back to lexical search when embeddings or the reranker fail.",
      "tags": [
        "hybrid-search",
        "reranking",
        "rag",
        "fusion"
      ],
      "complexity": "complex",
      "languageNotes": "Dense and lexical searches run together via asyncio.gather. Relevance is the max of the cross-encoder score and a scaled cosine, with term coverage lifting lexical hits."
    },
