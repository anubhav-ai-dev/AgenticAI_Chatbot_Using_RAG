    {
      "id": "file:backend/services/index_store.py",
      "type": "file",
      "name": "index_store.py",
      "filePath": "backend/services/index_store.py",
      "summary": "Persistent hybrid index that stores chunk text in SQLite with FTS5 BM25 and per-user FAISS indexes keyed by a hash of the user id, committing rows and vectors together.",
      "tags": [
        "hybrid-index",
        "sqlite",
        "faiss",
        "retrieval",
        "persistence"
      ],
      "complexity": "complex",
      "languageNotes": "FTS5 is an external-content table kept in sync by insert, delete, and update triggers. FAISS IndexIDMap2 files are written with an atomic replace and loaded with read_index so user ids never become filesystem paths."
    },
    {
      "id": "class:backend/services/index_store.py:ChunkIn",
      "type": "class",
      "name": "ChunkIn",
      "filePath": "backend/services/index_store.py",
      "lineRange": [
        62,
        66
      ],
      "summary": "Input record for a chunk about to be indexed, carrying text, page, order, and arbitrary metadata.",
      "tags": [
        "data-model",
        "dataclass",
        "indexing"
      ],
      "complexity": "simple"
    },
    {
      "id": "class:backend/services/index_store.py:ChunkRecord",
