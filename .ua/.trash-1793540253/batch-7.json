{
  "nodes": [
    {
      "id": "file:backend/client/web_client.py",
      "type": "file",
      "name": "web_client.py",
      "filePath": "backend/client/web_client.py",
      "summary": "SSRF-safe HTTP client that downloads HTML and text pages for URL ingestion, re-validating every redirect and rejecting oversized responses.",
      "tags": ["http-client", "ssrf", "ingestion", "service"],
      "complexity": "moderate",
      "languageNotes": "httpx is created with follow_redirects disabled so each Location hop can be joined and checked before the next GET."
    },
    {
      "id": "class:backend/client/web_client.py:WebPageClient",
      "type": "class",
      "name": "WebPageClient",
      "filePath": "backend/client/web_client.py",
      "lineRange": [17, 53],
      "summary": "Blocking page fetcher that accepts an optional private-URL override and a request timeout, then downloads text-like responses.",
      "tags": ["http-client", "ssrf", "service"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/client/web_client.py:fetch_html",
      "type": "function",
      "name": "fetch_html",
      "filePath": "backend/client/web_client.py",
      "lineRange": [22, 53],
      "summary": "GETs a URL in a manual redirect loop, checks each hop with the SSRF guard, filters content types, and stops if the body exceeds 5 MB.",
      "tags": ["http-client", "ssrf", "redirect-guard", "size-limit"],
      "complexity": "moderate"
    },
    {
      "id": "file:backend/services/parser.py",
      "type": "file",
      "name": "parser.py",
      "filePath": "backend/services/parser.py",
      "summary": "Converts uploaded documents and web pages into page records of text plus metadata, covering PDF, Office, CSV, Excel, HTML, JSON, images, and plain text.",
      "tags": ["document-parser", "ingestion", "ocr", "multi-format"],
      "complexity": "complex",
      "languageNotes": "Optional format libraries are imported inside each handler. PDF text tries pdfium, then pdfplumber, then PyPDF2, and OCRs pages that have almost no text layer."
    },
    {
      "id": "class:backend/services/parser.py:DocumentParser",
      "type": "class",
      "name": "DocumentParser",
      "filePath": "backend/services/parser.py",
      "lineRange": [41, 460],
      "summary": "Dispatches files by extension and URLs through article extraction, returning chunked page dicts ready for indexing.",
      "tags": ["document-parser", "ingestion", "service", "multi-format"],
      "complexity": "complex"
    },
    {
      "id": "function:backend/services/parser.py:parse_file",
      "type": "function",
      "name": "parse_file",
      "filePath": "backend/services/parser.py",
      "lineRange": [47, 63],
      "summary": "Routes a saved upload to the handler for its extension and rejects types outside the supported document and image sets.",
      "tags": ["document-parser", "dispatch", "validation"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:parse_url",
      "type": "function",
      "name": "parse_url",
      "filePath": "backend/services/parser.py",
      "lineRange": [65, 74],
      "summary": "Fetches a page, extracts article text, and splits it into roughly 1200-character chunks tagged with the parser name and source URL.",
      "tags": ["document-parser", "url-ingestion", "chunking"],
      "complexity": "simple"
    },
    {
      "id": "function:backend/services/parser.py:_extract_article",
      "type": "function",
      "name": "_extract_article",
      "filePath": "backend/services/parser.py",
      "lineRange": [77, 96],
      "summary": "Pulls readable article text with trafilatura and falls back to BeautifulSoup after dropping script, style, and navigation tags.",
      "tags": ["html", "article-extraction", "fallback"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:_parse_pdf",
      "type": "function",
      "name": "_parse_pdf",
      "filePath": "backend/services/parser.py",
      "lineRange": [100, 119],
      "summary": "Reads a PDF text layer with the first successful parser, then OCRs pages that were nearly blank and returns pages in order.",
      "tags": ["pdf", "ocr", "fallback"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:_pdf_pdfium",
      "type": "function",
      "name": "_pdf_pdfium",
      "filePath": "backend/services/parser.py",
      "lineRange": [122, 142],
      "summary": "Extracts per-page text with pypdfium2, capping the document at 1000 pages and recording pages below the minimum character count as OCR candidates.",
      "tags": ["pdf", "pdfium", "text-extraction"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:_pdf_pdfplumber",
      "type": "function",
      "name": "_pdf_pdfplumber",
      "filePath": "backend/services/parser.py",
      "lineRange": [145, 158],
      "summary": "Fallback PDF reader that uses pdfplumber, including table text, and flags pages that are too short for the text layer.",
      "tags": ["pdf", "pdfplumber", "text-extraction"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:_pdf_pypdf2",
      "type": "function",
      "name": "_pdf_pypdf2",
      "filePath": "backend/services/parser.py",
      "lineRange": [161, 175],
      "summary": "Last-resort PDF text extraction with PyPDF2, using the same page cap and blank-page detection as the faster readers.",
      "tags": ["pdf", "pypdf2", "text-extraction"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:_ocr_pdf_pages",
      "type": "function",
      "name": "_ocr_pdf_pages",
      "filePath": "backend/services/parser.py",
      "lineRange": [177, 203],
      "summary": "Renders up to 30 sparse PDF pages and runs them through the shared OCR engine, returning nothing when OCR is unavailable.",
      "tags": ["pdf", "ocr", "scanned-document"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:_parse_image",
      "type": "function",
      "name": "_parse_image",
      "filePath": "backend/services/parser.py",
      "lineRange": [205, 225],
      "summary": "OCRs a raster image after converting it to RGB and downscaling the long side, raising a parse error when no text is found.",
      "tags": ["ocr", "image", "text-extraction"],
      "complexity": "moderate"
    },
    {
