    },
    {
      "id": "function:backend/services/parser.py:_paginate_text",
      "type": "function",
      "name": "_paginate_text",
      "filePath": "backend/services/parser.py",
      "lineRange": [329, 345],
      "summary": "Groups blank-line-separated sections into pages of about 800 characters and stamps each page with the parser name.",
      "tags": ["chunking", "text", "pagination"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/services/parser.py:_parse_json",
      "type": "function",
      "name": "_parse_json",
      "filePath": "backend/services/parser.py",
      "lineRange": [347, 367],
      "summary": "Pretty-prints valid JSON and packs the lines into pages of about 800 characters, rejecting malformed input.",
