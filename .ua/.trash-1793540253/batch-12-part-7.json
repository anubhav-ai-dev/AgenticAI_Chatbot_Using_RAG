    {
      "id": "file:frontend/js/ui.js",
      "type": "file",
      "name": "ui.js",
      "filePath": "frontend/js/ui.js",
      "summary": "Shell renderer for the sidebar, session list, composer menus, upload toasts, citation and URL dialogs, and settings hand-off. It paints DOM only and reaches sibling views through window globals.",
      "tags": [
        "entry-point",
        "component",
        "view",
        "shell"
      ],
      "complexity": "complex",
      "languageNotes": "Assigned to window.UI from an IIFE. Sibling modules are globals rather than ES imports, so the shell can call Theme, Utils, Workspaces, and SettingsView without a module graph."
    },
