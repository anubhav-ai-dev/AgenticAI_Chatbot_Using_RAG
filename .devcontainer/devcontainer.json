{
  "name": "AI Assistant Pro",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "backend/main.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "[ -f requirements-dev.txt ] && pip3 install --user -r requirements-dev.txt; [ -f .env ] || cp .env.example .env; echo 'Packages installed'",
  "postAttachCommand": {
    "server": "uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "portsAttributes": {
    "8000": {
      "label": "AI Assistant Pro (API + UI)",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8000]
}
