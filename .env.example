# ═══ AI Assistant Pro — configuration ═══════════════════════════════════════
# Everything below is read ONLY by backend/core/config.py. Every value has a safe
# default; only the API keys are needed to get started. Blank values are ignored.

# ── API keys (all optional — missing keys disable that provider, never crash) ──
GROQ_API_KEY=            # https://console.groq.com  (free tier)
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey  (free tier)
TAVILY_API_KEY=          # https://tavily.com  (web search)
COHERE_API_KEY=          # only if EMBED_PROVIDER/RERANK_PROVIDER=cohere

# ── Chat models (free tier only) ──────────────────────────────────────────────
LLM_DEFAULT_MODEL=openai/gpt-oss-120b
# Tried in order when the requested model fails before its first token
LLM_FALLBACK_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b,gemini-3.5-flash-lite,gemini-3.7-flash
# Small/fast model used for follow-up query rewriting
LLM_FAST_MODEL=openai/gpt-oss-20b
# Optional JSON list replacing the built-in model registry, e.g.
# LLM_MODELS=[{"id":"openai/gpt-oss-20b","label":"GPT-OSS 20B","provider":"groq","extra":{"reasoning_effort":"low"},"rpm":30,"tpm":8000}]
LLM_MODELS=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_FIRST_TOKEN_TIMEOUT_S=12
MODEL_DISCOVERY=true

# ── Embeddings + reranking (local ONNX by default: free, no quota) ────────────
EMBED_PROVIDER=local          # local | google | cohere
EMBED_MODEL=                  # blank = provider default (BAAI/bge-small-en-v1.5)
RERANK_PROVIDER=local         # local | cohere | none
RERANK_MODEL=                 # blank = provider default (Xenova/ms-marco-MiniLM-L-6-v2)
RERANK_ENABLED=true
RERANK_CANDIDATES=8
RERANK_MAX_CHARS=600

# ── Retrieval ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RAG_CANDIDATE_K=30
RAG_TOP_K=5
RRF_K=60
RAG_MIN_RELEVANCE=0.2
RAG_COSINE_FLOOR=0.5          # calibrated for bge-small; adjust if you change EMBED_MODEL
RAG_COSINE_CEIL=0.8

# ── Web search ────────────────────────────────────────────────────────────────
TAVILY_SEARCH_DEPTH=basic     # basic | advanced   (research mode always uses TAVILY_RESEARCH_DEPTH)
TAVILY_RESEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=4
SEARCH_TIMEOUT_S=6

# ── Conversation / caching / limits ───────────────────────────────────────────
HISTORY_MAX_MESSAGES=10
HISTORY_TOKEN_BUDGET=1200
CONTEXT_TOKEN_BUDGET=2000
QUERY_REWRITE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
RATE_LIMIT_RPM_PER_USER=30
MAX_UPLOAD_MB=20

# ── Server / storage ──────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (frontend is served from the same origin)
ALLOWED_ORIGINS=http://localhost:8000
# Blank = SQLite at <DATA_DIR>/chatbot.db
DATABASE_URL=
# Blank = ./data (holds chatbot.db, index/ and models/)
DATA_DIR=
LOG_LEVEL=INFO
