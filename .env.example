# ── Required API Keys ─────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ── Optional (for users with paid accounts) ───────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS: comma-separated origins allowed to call the API ─────────────────────
# Local dev: http://localhost:8000 (frontend served by FastAPI on same origin)
# Production: add your Render/Railway URL here
ALLOWED_ORIGINS=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use default SQLite at data/chatbot.db
DATABASE_URL=
