# Required API keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Backend server settings (optional — defaults shown)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend — where the Streamlit app sends requests
# Local dev: leave as default
# Production: set to your deployed backend URL (no trailing slash)
BACKEND_URL=http://localhost:8000

# CORS — comma-separated list of origins allowed to call the backend
# Local dev: leave as default
# Production: set to your deployed frontend URL
ALLOWED_ORIGINS=http://localhost:8501
